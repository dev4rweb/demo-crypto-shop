APP_NAME=Nexus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo-crypto-shop.dev4rweb.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u258706838_crypto_shop
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Hostinger SMTP. QUEUE_CONNECTION=database + scheduler drains the queue.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=noreply@dev4rweb.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@dev4rweb.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

PAYMENT_DRIVER=testnet
PAYMENT_COINS=USDT,BTC,ETH
PAYMENT_INVOICE_TTL=30
PAYMENT_UNDERPAY_TOLERANCE=1
PAYMENT_USDT_ADDRESS=
PAYMENT_BTC_ADDRESS=
PAYMENT_ETH_ADDRESS=

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=true

CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# After deploy: php artisan telegram:set-webhook
# Webhook: https://demo-crypto-shop.dev4rweb.com/telegram/webhook

# Customer passwordless sign-in. Empty keys hide Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://demo-crypto-shop.dev4rweb.com/auth/google/callback
